        function toggleTask(type, id) {
            const task = appData.tasks[type].find(t => t.id === id);
            if (task) task.completed = !task.completed;
            saveState();
        }

        function addTask(type) {
            const text = prompt(`New ${type.toUpperCase()} task description:`);
            if (!text) return;
            appData.tasks[type].push({ id: Date.now(), text, completed: false });
            saveState();
        }

