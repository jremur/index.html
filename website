<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cozy Desk Studio | Student Dashboard</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&family=Satisfy&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: '#fcfaf2',
                        'pale-jade': '#e8efe2',
                        'soft-matcha': '#c6d3a0',
                        'olive-matcha': '#94aa6e',
                        'roasted-green': '#5f7f3d',
                        'dark-tea': '#3d5526',
                        'forest-shadow': '#25391a',
                        'paper-warm': '#f4eedd',
                    },
                    fontFamily: {
                        sans: ['Quicksand', 'sans-serif'],
                        display: ['Fredoka', 'sans-serif'],
                        handwriting: ['Satisfy', 'cursive'],
                    },
                    boxShadow: {
                        'cozy': '4px 6px 0px rgba(37, 57, 26, 0.15)',
                        'cozy-lg': '6px 10px 0px rgba(37, 57, 26, 0.18)',
                        'inset-soft': 'inset 2px 2px 6px rgba(0,0,0,0.06)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #fcfaf2;
            color: #25391a;
            background-image: radial-gradient(#94aa6e 0.65px, transparent 0.65px), radial-gradient(#94aa6e 0.65px, #fcfaf2 0.65px);
            background-size: 26px 26px;
            background-position: 0 0, 13px 13px;
        }

        /* Scrapbook & Tape effects */
        .tape-top {
            position: relative;
        }
        .tape-top::before {
            content: '';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%) rotate(-1.5deg);
            width: 90px;
            height: 24px;
            background-color: rgba(232, 239, 226, 0.75);
            backdrop-filter: blur(2px);
            border: 1px dashed rgba(95, 127, 61, 0.3);
            z-index: 10;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #e8efe2;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #94aa6e;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #5f7f3d;
        }

        .tab-btn.active {
            background-color: #3d5526;
            color: #fcfaf2;
            box-shadow: 2px 3px 0px #25391a;
        }

        /* Custom Checkbox Animation */
        .cozy-checkbox:checked + span {
            text-decoration: line-through;
            color: #94aa6e;
            opacity: 0.8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans text-forest-shadow antialiased selection:bg-soft-matcha selection:text-dark-tea">

    <!-- AUTHENTICATION OVERLAY / MODAL -->
    <div id="authModal" class="fixed inset-0 z-50 flex items-center justify-center bg-forest-shadow/60 backdrop-blur-md p-4 transition-opacity duration-300">
        <div class="bg-cream border-4 border-dark-tea rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-cozy-lg relative overflow-hidden">
            <!-- Decorative Plant SVG Header -->
            <div class="flex justify-center mb-4">
                <svg class="w-16 h-16 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21c-4-4-7-7.5-7-11.5C5 5.5 8 3 12 3s7 2.5 7 6.5c0 4-3 7.5-7 11.5z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21V9m0 0C10.5 7.5 9 6 7 6m5 3c1.5-1.5 3-3 5-3"></path>
                </svg>
            </div>
            
            <div class="text-center mb-6">
                <h1 class="font-display text-3xl font-bold text-dark-tea">Cozy Desk Gate</h1>
                <p class="text-sm text-roasted-green mt-1">Enter your credentials to enter your sanctuary.</p>
                <span class="inline-block mt-2 text-xs bg-pale-jade text-dark-tea px-3 py-1 rounded-full font-semibold border border-soft-matcha">Default: admin / cozy2026</span>
            </div>

            <form id="loginForm" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-dark-tea mb-1">Username</label>
                    <input type="text" id="authUsername" required value="admin" class="w-full px-4 py-2.5 rounded-2xl border-2 border-olive-matcha bg-white focus:outline-none focus:border-dark-tea shadow-inset-soft text-dark-tea">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-dark-tea mb-1">Password</label>
                    <input type="password" id="authPassword" required value="cozy2026" class="w-full px-4 py-2.5 rounded-2xl border-2 border-olive-matcha bg-white focus:outline-none focus:border-dark-tea shadow-inset-soft text-dark-tea">
                </div>
                <div id="authError" class="hidden text-red-600 text-xs text-center font-semibold pt-1">Invalid username or password!</div>
                <button type="submit" class="w-full py-3 bg-roasted-green hover:bg-dark-tea text-cream font-display font-bold rounded-2xl shadow-cozy transition-all transform active:translate-y-1">
                    Unlock Studio
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN APP WRAPPER (Hidden until authenticated) -->
    <div id="appContainer" class="hidden min-h-screen flex flex-col">
        
        <!-- TOP NAVBAR -->
        <header class="bg-pale-jade/90 backdrop-blur-md border-b-2 border-olive-matcha sticky top-0 z-40 px-4 sm:px-8 py-3">
            <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4">
                
                <div class="flex items-center gap-3">
                    <div class="bg-soft-matcha p-2 rounded-2xl border border-olive-matcha shadow-sm">
                        <svg class="w-6 h-6 text-dark-tea" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-display font-bold text-xl sm:text-2xl text-dark-tea leading-tight">My Cozy Studio</h1>
                        <p class="text-xs text-roasted-green font-medium">Student Life Dashboard</p>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="flex flex-wrap items-center gap-1 sm:gap-2 bg-cream p-1.5 rounded-2xl border border-soft-matcha">
                    <button onclick="switchTab('academic')" id="tab-academic" class="tab-btn active px-3 sm:px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all">Academics</button>
                    <button onclick="switchTab('tasks')" id="tab-tasks" class="tab-btn px-3 sm:px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all">Tasks & Cal</button>
                    <button onclick="switchTab('life')" id="tab-life" class="tab-btn px-3 sm:px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all">Home & Pets</button>
                    <button onclick="switchTab('archive')" id="tab-archive" class="tab-btn px-3 sm:px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all">Memories</button>
                    <button onclick="switchTab('finance')" id="tab-finance" class="tab-btn px-3 sm:px-4 py-1.5 rounded-xl text-xs sm:text-sm font-bold transition-all">Ledger</button>
                </nav>

                <!-- Admin Action -->
                <div class="flex items-center gap-3">
                    <span id="greetingUser" class="text-xs font-semibold text-roasted-green hidden sm:inline">Hello, Student</span>
                    <button onclick="logout()" class="p-2 bg-soft-matcha hover:bg-olive-matcha text-dark-tea rounded-xl transition-all shadow-sm" title="Lock Dashboard">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>

            </div>
        </header>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
            
            <!-- SECTION 1: ACADEMIC & EDUCATION HUBS -->
            <section id="sec-academic" class="tab-section space-y-6">
                
                <!-- Roadmap & Milestones -->
                <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-6 shadow-cozy relative tape-top">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center gap-2">
                            <svg class="w-6 h-6 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                            <h2 class="font-display font-bold text-xl text-dark-tea">Academic Roadmap & Long-Term Goals</h2>
                        </div>
                        <button onclick="addMilestone()" class="px-3 py-1 bg-soft-matcha hover:bg-olive-matcha text-dark-tea text-xs font-bold rounded-xl transition-all shadow-sm">+ Add Goal</button>
                    </div>

                    <div id="roadmapContainer" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Dynamic Milestones injected here -->
                    </div>
                </div>

                <!-- Active Class Hubs Grid -->
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="font-display font-bold text-xl text-dark-tea flex items-center gap-2">
                            <svg class="w-6 h-6 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                            Active Classes Hub
                        </h2>
                        <button onclick="addClassModal()" class="px-3 py-1 bg-roasted-green hover:bg-dark-tea text-cream text-xs font-bold rounded-xl transition-all shadow-sm">+ Add Class</button>
                    </div>

                    <div id="classesGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <!-- Class Cards Injected Here -->
                    </div>
                </div>

            </section>

            <!-- SECTION 2: PRODUCTIVITY & FLEXIBLE TASK MANAGEMENT -->
            <section id="sec-tasks" class="tab-section hidden space-y-6">
                
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <!-- Tiered To-Do Lists (2 Cols) -->
                    <div class="lg:col-span-2 space-y-6">
                        
                        <!-- Daily Tasks Card -->
                        <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy relative">
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="font-display font-bold text-lg text-dark-tea flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-roasted-green"></span> Daily Priorities
                                </h3>
                                <button onclick="addTask('daily')" class="text-xs bg-pale-jade hover:bg-soft-matcha text-dark-tea px-2.5 py-1 rounded-xl font-bold">+ Task</button>
                            </div>
                            <div id="dailyTasksList" class="space-y-2 max-h-56 overflow-y-auto pr-1"></div>
                        </div>

                        <!-- Weekly Checklist Card -->
                        <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy relative">
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="font-display font-bold text-lg text-dark-tea flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-olive-matcha"></span> Weekly Focus
                                </h3>
                                <button onclick="addTask('weekly')" class="text-xs bg-pale-jade hover:bg-soft-matcha text-dark-tea px-2.5 py-1 rounded-xl font-bold">+ Task</button>
                            </div>
                            <div id="weeklyTasksList" class="space-y-2 max-h-56 overflow-y-auto pr-1"></div>
                        </div>

                        <!-- Monthly Objectives Card -->
                        <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy relative">
                            <div class="flex justify-between items-center mb-3">
                                <h3 class="font-display font-bold text-lg text-dark-tea flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-soft-matcha"></span> Monthly Vision
                                </h3>
                                <button onclick="addTask('monthly')" class="text-xs bg-pale-jade hover:bg-soft-matcha text-dark-tea px-2.5 py-1 rounded-xl font-bold">+ Objective</button>
                            </div>
                            <div id="monthlyTasksList" class="space-y-2 max-h-56 overflow-y-auto pr-1"></div>
                        </div>

                    </div>

                    <!-- Dynamic Google-Style Calendar Widget (1 Col) -->
                    <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-display font-bold text-lg text-dark-tea flex items-center gap-2">
                                    <svg class="w-5 h-5 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    Calendar
                                </h3>
                                <span id="calMonthYear" class="text-xs font-bold text-roasted-green bg-pale-jade px-2.5 py-1 rounded-lg"></span>
                            </div>

                            <!-- Interactive Mini Calendar -->
                            <div class="bg-white rounded-2xl p-3 border border-soft-matcha shadow-inset-soft">
                                <div class="grid grid-cols-7 gap-1 text-center font-bold text-xs text-olive-matcha mb-2">
                                    <div>Su</div><div>Mo</div><div>Tu</div><div>We</div><div>Th</div><div>Fr</div><div>Sa</div>
                                </div>
                                <div id="calendarDaysGrid" class="grid grid-cols-7 gap-1 text-center text-xs font-medium"></div>
                            </div>

                            <!-- Selected Day Events View -->
                            <div class="mt-4">
                                <div class="flex justify-between items-center mb-2">
                                    <h4 id="selectedDateTitle" class="text-xs font-bold text-dark-tea uppercase tracking-wider">Events</h4>
                                    <button onclick="openAddEventModal()" class="text-xs bg-roasted-green text-cream px-2 py-0.5 rounded-lg font-bold hover:bg-dark-tea">+ Add</button>
                                </div>
                                <div id="dayEventsList" class="space-y-1.5 max-h-40 overflow-y-auto pr-1 text-xs"></div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-soft-matcha text-[11px] text-roasted-green flex items-center justify-between">
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-roasted-green"></span> Exam/Appt</span>
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-olive-matcha"></span> Holiday/Fun</span>
                        </div>
                    </div>

                </div>

            </section>

            <!-- SECTION 3: HOUSEHOLD & PET CARE -->
            <section id="sec-life" class="tab-section hidden space-y-6">
                
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    
                    <!-- Pet Routine Tracker -->
                    <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-6 shadow-cozy space-y-4">
                        <div class="flex justify-between items-center">
                            <h2 class="font-display font-bold text-xl text-dark-tea flex items-center gap-2">
                                <svg class="w-6 h-6 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m0 0l-2-1m2 1v2.5M14 4l-2 1m0 0l-2-1m2 1v2.5M4 7l2-1m-2 1v2.5m2-2.5l2 1m-4 1.5l2 1m-2 1v2.5m2-2.5l2 1m-4 1.5l2 1m-2 1v2.5"></path></svg>
                                Pet Care Profiles
                            </h2>
                            <button onclick="addPetModal()" class="text-xs bg-soft-matcha hover:bg-olive-matcha text-dark-tea font-bold px-3 py-1 rounded-xl">+ Add Pet</button>
                        </div>

                        <div id="petsContainer" class="space-y-4">
                            <!-- Dynamic Pet Cards Injected Here -->
                        </div>
                    </div>

                    <!-- Household Chores Checklist -->
                    <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-6 shadow-cozy space-y-4">
                        <div class="flex justify-between items-center">
                            <h2 class="font-display font-bold text-xl text-dark-tea flex items-center gap-2">
                                <svg class="w-6 h-6 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                                Household Chores
                            </h2>
                            <button onclick="addChoreModal()" class="text-xs bg-soft-matcha hover:bg-olive-matcha text-dark-tea font-bold px-3 py-1 rounded-xl">+ Add Chore</button>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <h3 class="text-xs font-bold text-dark-tea uppercase tracking-wider mb-2">Daily Maintenance</h3>
                                <div id="dailyChoresList" class="space-y-2"></div>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-dark-tea uppercase tracking-wider mb-2">Weekly Refresh</h3>
                                <div id="weeklyChoresList" class="space-y-2"></div>
                            </div>
                        </div>
                    </div>

                </div>

            </section>

            <!-- SECTION 4: RECREATION & PERSONAL ARCHIVE -->
            <section id="sec-archive" class="tab-section hidden space-y-6">
                
                <!-- Fun Activities & Scrapbook -->
                <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-6 shadow-cozy space-y-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="font-display font-bold text-xl text-dark-tea flex items-center gap-2">
                                <svg class="w-6 h-6 text-roasted-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Memory Scrapbook & Outings
                            </h2>
                            <p class="text-xs text-roasted-green">Capture special moments, photos, and time spent with friends.</p>
                        </div>
                        <button onclick="openAddMemoryModal()" class="px-3 py-1.5 bg-roasted-green hover:bg-dark-tea text-cream text-xs font-bold rounded-xl shadow-sm transition-all">+ Add Memory</button>
                    </div>

                    <div id="scrapbookGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 pt-2">
                        <!-- Scrapbook Cards Injected Here -->
                    </div>
                </div>

                <!-- Volunteer Hours Log -->
                <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-6 shadow-cozy space-y-4">
                    <div class="flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <h2 class="font-display font-bold text-xl text-dark-tea">Volunteer Hours Tracker</h2>
                            <div class="bg-pale-jade border border-soft-matcha px-3 py-1 rounded-full text-xs font-bold text-dark-tea">
                                Total: <span id="totalVolunteerHours" class="text-roasted-green font-extrabold text-sm">0</span> hrs
                            </div>
                        </div>
                        <button onclick="openAddVolunteerModal()" class="text-xs bg-soft-matcha hover:bg-olive-matcha text-dark-tea font-bold px-3 py-1.5 rounded-xl">+ Log Hours</button>
                    </div>

                    <div class="overflow-x-auto rounded-2xl border border-soft-matcha">
                        <table class="w-full text-left text-xs text-dark-tea bg-white">
                            <thead class="bg-pale-jade text-dark-tea font-bold border-b border-soft-matcha">
                                <tr>
                                    <th class="p-3">Date</th>
                                    <th class="p-3">Organization / Event</th>
                                    <th class="p-3">Hours</th>
                                    <th class="p-3">Companions</th>
                                    <th class="p-3 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="volunteerLogTable" class="divide-y divide-pale-jade">
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </section>

            <!-- SECTION 5: FINANCIAL LEDGER -->
            <section id="sec-finance" class="tab-section hidden space-y-6">
                
                <!-- Overview Stats Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy">
                        <span class="text-xs font-bold uppercase tracking-wider text-roasted-green">Total Sales / Income</span>
                        <p class="text-2xl font-display font-bold text-roasted-green mt-1" id="statTotalSales">$0.00</p>
                    </div>
                    <div class="bg-cream border-2 border-soft-matcha rounded-3xl p-5 shadow-cozy">
                        <span class="text-xs font-bold uppercase tracking-wider text-red-600">Total Purchases</span>
                        <p class="text-2xl font-display font-bold text-red-600 mt-1" id="statTotalPurchases">$0.00</p>
                    </div>
                    <div class="bg-cream border-2 border-dark-tea rounded-3xl p-5 shadow-cozy bg-gradient-to-br from-pale-jade to-cream">
                        <span class="text-xs font-bold uppercase tracking-wider text-dark-tea">Net Balance</span>
                        <p class="text-2xl font-display font-bold text-dark-tea mt-1" id="statNetBalance">$0.00</p>
                    </div>
