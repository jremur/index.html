                    <tr class="hover:bg-pale-jade/40 transition-all">
                        <td class="p-3 font-semibold">${v.date}</td>
                        <td class="p-3 font-bold text-dark-tea">${v.org}</td>
                        <td class="p-3 font-bold text-roasted-green">${parseFloat(v.hours).toFixed(1)} hrs</td>
                        <td class="p-3">${v.companions}</td>
                        <td class="p-3 text-right">
                            <button onclick="deleteVolunteer(${v.id})" class="text-red-500 hover:underline font-bold text-[11px]">Delete</button>
                        </td>
                    </tr>
                `;
            }).join('');

            totalHoursEl.textContent = total.toFixed(1);
        }

        function openAddVolunteerModal() {
            const org = prompt("Organization / Event Name:");
            if (!org) return;
            const hours = parseFloat(prompt("Hours spent (e.g., 3.5):", "2.0"));
            const date = prompt("Date (YYYY-MM-DD):", new Date().toISOString().split('T')[0]);
            const companions = prompt("Companions / Host:", "Self");

            if (isNaN(hours)) return;

            appData.volunteer.push({
                id: Date.now(),
                date: date || 'Today',
                org,
                hours,
                companions: companions || 'None'
            });
            saveState();
        }

        function deleteVolunteer(id) {
            appData.volunteer = appData.volunteer.filter(v => v.id !== id);
            saveState();
        }

        /* ----------------------------------------------------
           MODULE D: HOUSEHOLD & PET CARE
        ---------------------------------------------------- */
        function renderPets() {
            const container = document.getElementById('petsContainer');
            container.innerHTML = appData.pets.map(p => `
                <div class="bg-white border border-soft-matcha rounded-2xl p-4 shadow-sm space-y-3">
                    <div class="flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-dark-tea text-base">${p.name}</h4>
                            <span class="text-xs text-roasted-green font-medium">${p.breed}</span>
                        </div>
                        <button onclick="deletePet(${p.id})" class="text-xs text-red-500 hover:underline">Remove</button>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                        <button onclick="togglePetCare(${p.id}, 'feedMorning')" class="p-2 rounded-xl text-center border font-bold transition-all ${p.feedMorning ? 'bg-roasted-green text-cream border-dark-tea' : 'bg-pale-jade text-dark-tea border-soft-matcha'}">
                            Morning Feed
                        </button>
                        <button onclick="togglePetCare(${p.id}, 'feedEvening')" class="p-2 rounded-xl text-center border font-bold transition-all ${p.feedEvening ? 'bg-roasted-green text-cream border-dark-tea' : 'bg-pale-jade text-dark-tea border-soft-matcha'}">
                            Evening Feed
                        </button>
                        <button onclick="togglePetCare(${p.id}, 'medsGiven')" class="p-2 rounded-xl text-center border font-bold transition-all ${p.medsGiven ? 'bg-roasted-green text-cream border-dark-tea' : 'bg-pale-jade text-dark-tea border-soft-matcha'}">
                            Meds / Vitamins
                        </button>
                        <button onclick="togglePetCare(${p.id}, 'groomingDone')" class="p-2 rounded-xl text-center border font-bold transition-all ${p.groomingDone ? 'bg-roasted-green text-cream border-dark-tea' : 'bg-pale-jade text-dark-tea border-soft-matcha'}">
                            Grooming / Walk
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function togglePetCare(petId, key) {
            const pet = appData.pets.find(p => p.id === petId);
            if (pet) {
                pet[key] = !pet[key];
            }
            saveState();
        }

        function addPetModal() {
            const name = prompt("Pet Name:");
            if (!name) return;
            const breed = prompt("Species / Breed:", "Cat");
            appData.pets.push({
                id: Date.now(),
                name,
                breed: breed || 'Pet',
                feedMorning: false,
                feedEvening: false,
                medsGiven: false,
                groomingDone: false
            });
            saveState();
        }

        function deletePet(id) {
            appData.pets = appData.pets.filter(p => p.id !== id);
            saveState();
        }

        function renderChores() {
            ['daily', 'weekly'].forEach(freq => {
                const container = document.getElementById(`${freq}ChoresList`);
                container.innerHTML = appData.chores[freq].map(c => `
                    <label class="flex items-center justify-between p-2 rounded-xl bg-white border border-pale-jade cursor-pointer">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" ${c.completed ? 'checked' : ''} onchange="toggleChore('${freq}', ${c.id})" class="cozy-checkbox accent-roasted-green rounded">
                            <span class="text-xs font-medium text-dark-tea">${c.name}</span>
                        </div>
                    </label>
                `).join('');
            });
        }

        function toggleChore(freq, id) {
            const chore = appData.chores[freq].find(c => c.id === id);
            if (chore) chore.completed = !chore.completed;
            saveState();
        }

        function addChoreModal() {
            const name = prompt("Chore Name:");
            if (!name) return;
            const freq = prompt("Frequency (daily or weekly):", "daily").toLowerCase();
            const targetFreq = (freq === 'weekly') ? 'weekly' : 'daily';
            
            appData.chores[targetFreq].push({
                id: Date.now(),
                name,
                completed: false
            });
            saveState();
        }

        /* ----------------------------------------------------
           MODULE E: FINANCIAL LEDGER
        ---------------------------------------------------- */
        function renderLedger() {
            const tbody = document.getElementById('ledgerTableBody');
            let totalSales = 0;
            let totalPurchases = 0;

            tbody.innerHTML = appData.ledger.map(tx => {
                const amt = parseFloat(tx.amount);
                if (tx.type === 'sale') totalSales += amt;
                else totalPurchases += amt;

                return `
                    <tr class="hover:bg-pale-jade/40 transition-all">
                        <td class="p-3 text-dark-tea font-medium">${tx.date}</td>
                        <td class="p-3 font-bold ${tx.type === 'sale' ? 'text-roasted-green' : 'text-red-600'}">
                            ${tx.type.toUpperCase()}
                        </td>
                        <td class="p-3 font-semibold text-dark-tea">${tx.item}</td>
                        <td class="p-3 text-right font-extrabold ${tx.type === 'sale' ? 'text-roasted-green' : 'text-red-600'}">
                            ${tx.type === 'sale' ? '+' : '-'}$${amt.toFixed(2)}
                        </td>
                        <td class="p-3 text-center">
                            <button onclick="deleteLedger(${tx.id})" class="text-red-500 hover:underline text-xs font-bold">Delete</button>
                        </td>
                    </tr>
                `;
            }).join('');

            const net = totalSales - totalPurchases;

            document.getElementById('statTotalSales').textContent = `$${totalSales.toFixed(2)}`;
            document.getElementById('statTotalPurchases').textContent = `$${totalPurchases.toFixed(2)}`;
            
            const netEl = document.getElementById('statNetBalance');
            netEl.textContent = `$${net.toFixed(2)}`;
            netEl.className = `text-2xl font-display font-bold mt-1 ${net >= 0 ? 'text-roasted-green' : 'text-red-600'}`;
        }

        function handleLedgerSubmit(e) {
            e.preventDefault();
            const type = document.getElementById('txType').value;
            const item = document.getElementById('txItem').value;
            const amount = parseFloat(document.getElementById('txAmount').value);
            const date = document.getElementById('txDate').value || new Date().toISOString().split('T')[0];

            if (!item || isNaN(amount) || amount <= 0) return;

            appData.ledger.push({
                id: Date.now(),
                type,
                item,
                amount: parseFloat(amount.toFixed(2)),
                date
            });

            document.getElementById('txItem').value = '';
            document.getElementById('txAmount').value = '';

            saveState();
        }

        function deleteLedger(id) {
            appData.ledger = appData.ledger.filter(tx => tx.id !== id);
            saveState();
        }
    </script>
</body>
</html>
