            const name = prompt("Assessment Name (e.g., Quiz 1):");
            if (!name) return;
            const score = parseFloat(prompt("Score Percent (0-100):", "90"));
            const weight = parseFloat(prompt("Weight Percent (e.g., 15 for 15%):", "10"));
            if (isNaN(score) || isNaN(weight)) return;

            const cls = appData.classes.find(c => c.id === classId);
            if (cls) {
                cls.grades.push({ name, score, weight });
