            container.innerHTML = dayEvents.map(e => `
                <div class="flex justify-between items-center p-2 rounded-xl bg-pale-jade text-dark-tea font-medium">
                    <span>${e.title}</span>
                    <span class="text-[10px] bg-white px-1.5 py-0.5 rounded font-bold border border-soft-matcha">${e.type}</span>
                </div>
            `).join('');
        }

