            appData.tasks[type] = appData.tasks[type].filter(t => t.id !== id);
            saveState();
        }

        /* ----------------------------------------------------
           DYNAMIC CALENDAR WIDGET
        ---------------------------------------------------- */
        let currentCalDate = new Date();

        function initCalendar() {
            renderCalendarDays();
        }

        function renderCalendarDays() {
            const grid = document.getElementById('calendarDaysGrid');
            const monthTitle = document.getElementById('calMonthYear');
            
            const year = currentCalDate.getFullYear();
            const month = currentCalDate.getMonth();

            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthTitle.textContent = `${monthNames[month]} ${year}`;

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            grid.innerHTML = '';

            // Empty slots for alignment
            for (let i = 0; i < firstDay; i++) {
                grid.innerHTML += `<div class="p-1"></div>`;
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const hasEvent = appData.events.some(e => e.date === dateStr);
                const isSelected = dateStr === selectedCalendarDate;

                grid.innerHTML += `
                    <button onclick="selectCalDate('${dateStr}')" class="p-1.5 rounded-xl font-medium transition-all relative ${isSelected ? 'bg-roasted-green text-cream font-bold shadow-sm' : 'hover:bg-pale-jade text-dark-tea'}">
                        ${day}
                        ${hasEvent ? `<span class="absolute bottom-0.5 left-50% transform -translate-x-1/2 w-1.5 h-1.5 rounded-full ${isSelected ? 'bg-cream' : 'bg-roasted-green'}"></span>` : ''}
                    </button>
                `;
            }
        }

        function selectCalDate(dateStr) {
            selectedCalendarDate = dateStr;
            renderCalendarDays();
            renderSelectedDayEvents();
        }

        function renderSelectedDayEvents() {
            const title = document.getElementById('selectedDateTitle');
            const container = document.getElementById('dayEventsList');
            title.textContent = `Events on ${selectedCalendarDate}`;

            const dayEvents = appData.events.filter(e => e.date === selectedCalendarDate);
            if (dayEvents.length === 0) {
                container.innerHTML = `<p class="text-roasted-green text-[11px] italic">No events scheduled.</p>`;
                return;
